// update with migration ==>
// npx prisma migrate dev --name add_wallet_returns_shipping
// npx prisma generate
// npx prisma format
// در شرایط اضطراری 
// npx prisma migrate reset 
// npx prisma db push --force-reset
// in product ==> npx prisma migrate deploy

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// اطلاعات کاربر و احراز هویتش

model User {
  id              String     @id @default(uuid()) @db.Uuid
  email           String?    @unique
  name            String
  password        String?
  googleId        String?    @unique
  phone           String?    @unique
  role            RolePerson @default(USER)
  status          UserStatus @default(ACTIVE)
  isPhoneVerified Boolean    @default(false)
  isEmailVerified Boolean    @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  token                Token[]
  profile              Profile?
  addresses            Address[]
  store                Store?
  storeReviews         StoreReview[]
  orders               Order[]
  cartItems            CartItem[]
  checkouts            Checkout[]
  returnRequests       ReturnRequest[]
  wishlistItems        WishlistItem[]
  wallet               Wallet?
  walletTransactions   WalletTransaction[]
  bankAccounts         BankAccount[]
  tickets              Ticket[]
  ticketMessages       TicketMessage[]
  coach                Coach?
  coachReviews         CoachReview[]
  planRequests         PlanRequest[]
  subscriptions        Subscription[]
  userPlans            UserPlan[]
  userLogs             UserLog[]
  reviews              Review[]            @relation("ReviewUser")
  reviewAnswers        Review[]            @relation("ReviewAnswer")
  discountCodesCreated DiscountCode[]      @relation("DiscountCodeCreator")

  @@index([name])
  @@index([role])
  @@map("users")
}

model Profile {
  id     String @id @default(uuid())
  userId String @unique @map("user_id") @db.Uuid

  // اطلاعات شخصی
  avatar    String? @map("avatar")
  firstName String? @map("first_name")
  lastName  String? @map("last_name")

  // بدن
  heightCm        Float? @map("height_cm")
  currentWeightKg Float? @map("current_weight_kg")
  targetWeightKg  Float? @map("target_weight_kg")

  // سرچ بر اساس پروفایل
  activityLevel       ActivityLevel?    @map("activity_level")
  experienceLevel     ExperienceLevel?  @map("experience_level")
  gender              Gender?           @map("gender")
  trainingLocation    TrainingLocation? @map("training_location")
  age                 DateTime?         @map("age") @db.Date
  trainingDaysPerWeek Int?              @map("training_days_per_week")
  availableEquipment  String[]          @map("available_equipment")

  // سلامت و تغذیه
  injuries            String?  @map("injuries")
  medicalConditions   String?  @map("medical_conditions")
  allergies           String[] @map("allergies")
  dietaryRestrictions String[] @map("dietary_restrictions")
  trainingGoalId      String?  @map("training_goal_id")

  onboardingCompleted Boolean  @default(false) @map("onboarding_completed")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  trainingGoal TrainingGoal? @relation(fields: [trainingGoalId], references: [id])
}

model Address {
  id         String     @id @default(uuid())
  title      String?    @map("title")
  fullName   String     @map("full_name")
  phone      String     @map("phone")
  provinceId String     @map("province_id")
  cityId     String     @map("city_id")
  address    String     @map("address")
  postalCode String?    @map("postal_code")
  isDefault  Boolean    @default(false) @map("is_default")
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")
  userId     String     @map("user_id") @db.Uuid
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  province   Province   @relation(fields: [provinceId], references: [id], onDelete: Cascade)
  city       City       @relation(fields: [cityId], references: [id], onDelete: Cascade)
  checkouts  Checkout[]

  @@index([userId])
  @@map("addresses")
}

model Token {
  id          Int      @id @default(autoincrement())
  tokenHash   String   @unique @map("token_hash")
  userId      String   @map("user_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  device      String?  @map("device")
  ipAddress   String?  @map("ip_address")
  expiredDate DateTime @map("expired_date") @db.Date

  User User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("tokens")
}

model OtpCode {
  id         String     @id @default(uuid())
  target     String     @map("target") // شماره موبایل یا ایمیل
  codeHash   String     @map("code_hash")
  purpose    OtpPurpose @map("purpose")
  attempts   Int        @default(0) @map("attempts")
  expiresAt  DateTime   @map("expires_at")
  consumedAt DateTime?  @map("consumed_at")
  createdAt  DateTime   @default(now()) @map("created_at")

  @@index([target, purpose])
  @@map("otp_codes")
}

// سرویس ها
model SubscriptionPlan {
  id          String  @id @default(uuid())
  slug        String  @unique @map("slug") // basic, pro, premium
  title       String  @map("title")
  description String? @map("description")

  // قیمت و مدت
  price         Decimal  @map("price") @db.Decimal(12, 2)
  originalPrice Decimal? @map("original_price") @db.Decimal(12, 2) // قیمت خط‌خورده برای نمایش تخفیف
  durationDays  Int      @map("duration_days") // ۳۰، ۹۰، ۳۶۵
  trialDays     Int      @default(0) @map("trial_days")

  // امکاناتی که خود برنامه چک می‌کنه (null = نامحدود)
  aiPlanLimitPerMonth Int?    @map("ai_plan_limit_per_month")
  aiChatLimitPerDay   Int?    @map("ai_chat_limit_per_day")
  canRequestCoach     Boolean @default(false) @map("can_request_coach")
  canTrackProgress    Boolean @default(true) @map("can_track_progress")

  // نمایش در صفحه قیمت‌ها
  features  String[] @map("features") // لیست متنی ویژگی‌ها برای نمایش
  isPopular Boolean  @default(false) @map("is_popular") // نشان «محبوب‌ترین»
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  subscriptions Subscription[]

  @@index([isActive, sortOrder])
}

model Subscription {
  id     String             @id @default(uuid())
  userId String             @map("user_id") @db.Uuid
  planId String             @map("plan_id")
  status SubscriptionStatus @default(PENDING) @map("status")

  // snapshot قیمت در لحظه‌ی خرید (اگه بعداً قیمت پلن عوض شد، این تغییر نکنه)
  pricePaid Decimal @map("pricePaid") @db.Decimal(12, 2)

  startsAt    DateTime? @map("starts_at")
  endsAt      DateTime? @map("ends_at")
  cancelledAt DateTime? @map("cancelled_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user     User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  plan     SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  payments Payment[]

  @@index([userId, status])
  @@index([status, endsAt]) // برای cron job منقضی کردن اشتراک‌ها
}

//////////////// دیتایی که توسط ادمین پر میشه ///////////////////
// گروه عضلانی
model MuscleGroup {
  id        String     @id @default(uuid())
  slug      String     @unique @map("slug")
  title     String     @map("title")
  exercises Exercise[]

  @@map("muscle_groups")
}

// تجهیزات
model Equipment {
  id          String     @id @default(uuid())
  slug        String     @unique @map("slug")
  title       String     @map("title")
  image       String     @map("image")
  description String?    @map("description")
  exercises   Exercise[]

  @@map("equipments")
}

model Exercise {
  id          String          @id @default(uuid())
  slug        String          @unique @map("slug")
  title       String          @map("title")
  description String?         @map("description")
  notic       String[]        @map("notic")
  stepAction  String[]        @map("step_action")
  categoryId  String?         @map("category_id")
  level       ExperienceLevel @default(BEGINNER) @map("level")
  durationMin Int?            @map("duration_min")
  caloriesMin Int?            @map("calories_min")
  caloriesMax Int?            @map("calories_max")
  gif         String?         @map("gif_url")
  video       String?         @map("video_url")
  isActive    Boolean         @default(true) @map("is_active") // هیچ‌وقت حذف فیزیکی نکن، فقط غیرفعال کن

  category  Category? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  muscles      MuscleGroup[]
  equipment    Equipment[]
  workoutItems WorkoutDayExercise[]

  @@index([categoryId, level])
  @@map("exercises")
}

model Food {
  id              String  @id @default(uuid())
  name            String  @map("name")
  categoryId      String? @map("category_id")
  caloriesPer100g Float   @map("calories_per_100g")
  proteinPer100g  Float   @default(0) @map("protein_per_100g")
  carbsPer100g    Float   @default(0) @map("carbs_per_100g")
  fatPer100g      Float   @default(0) @map("fat_per_100g")
  isActive        Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at")
  category  Category? @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  mealItems DietMealItem[]

  @@index([name])
  @@map("foods")
}

// تخصص
model Specialty {
  id    String @id @default(uuid())
  slug  String @unique @map("slug") // weight-loss, bodybuilding, yoga, rehab, nutrition ...
  title String @map("title")

  coaches Coach[]

  @@map("specialties")
}

model TrainingGoal {
  id           String        @id @default(uuid())
  title        String        @map("title")
  logo         String?       @map("logo")
  description  String?       @map("description")
  profile      Profile[]
  workoutPlans WorkoutPlan[]
  dietPlans    DietPlan[]

  @@map("training_goal")
}

//////////////// دیتایی که توسط ادمین پر میشه ///////////////////

// مربی
model Coach {
  id                 String      @id @default(uuid())
  userId             String      @unique @map("user_id") @db.Uuid
  headline           String?     @map("headline") // مثلا: «مربی بدنسازی و تغذیه»
  bio                String?     @map("bio")
  nationalId         String?     @map("national_id") // کد ملی یا شناسه ملی
  instagram          String?     @map("instagram")
  address            String?     @map("address")
  commissionRate     Decimal     @default(0) @map("commission_rate") @db.Decimal(12, 2)
  provinceId         String?     @map("province_id")
  cityId             String?     @map("city_id")
  // ظرفیت
  maxClients         Int         @default(20) @map("max_clients")
  isAcceptingClients Boolean     @default(true) @map("is_accepting_clients")
  // تایید توسط ادمین
  status             CoachStatus @default(PENDING) @map("status")
  rejectionReason    String?     @map("rejection_reason")
  ratingAvg          Float       @default(0) @map("rating_avg")
  ratingCount        Int         @default(0) @map("rating_count")

  experienceYears DateTime? @map("experience_years") @db.Date
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  province       Province?           @relation(fields: [provinceId], references: [id])
  city           City?               @relation(fields: [cityId], references: [id])
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialties    Specialty[]
  certifications Certification[]
  availabilities CoachAvailability[]
  reviews        CoachReview[]
  planRequests   PlanRequest[]
  workoutPlans   WorkoutPlan[]
  dietPlans      DietPlan[]
  userPlans      UserPlan[]

  @@index([status])
  @@index([ratingAvg])
  @@map("coaches")
}

model Certification {
  id          String    @id @default(uuid())
  coachId     String    @map("coach_id")
  title       String    @map("title")
  issuer      String?   @map("issuer") // مثلا: فدراسیون بدنسازی
  issuedAt    DateTime? @map("issued_at") @db.Date
  expiresAt   DateTime? @map("expires_at") @db.Date
  documentUrl String?   @map("document_url") // عکس یا اسکن مدرک
  isVerified  Boolean   @default(false) @map("is_verified")
  verifiedAt  DateTime? @map("verified_at")

  createdAt DateTime @default(now()) @map("created_at")

  coach Coach @relation(fields: [coachId], references: [id], onDelete: Cascade)

  @@index([coachId])
  @@map("certifications")
}

model CoachAvailability {
  id        String @id @default(uuid())
  coachId   String @map("coach_id")
  weekday   Int    @map("weekday") // ۰ = شنبه ... ۶ = جمعه
  startTime String @map("start_time") // "09:00"
  endTime   String @map("end_time") // "13:00"

  coach Coach @relation(fields: [coachId], references: [id], onDelete: Cascade)

  @@index([coachId, weekday])
  @@map("coach_availabilities")
}

model PlanRequest {
  id                String  @id @default(uuid())
  userId            String  @map("user_id") @db.Uuid
  coachId           String  @map("coach_id")
  workoutTemplateId String? @map("workout_template_id")
  dietTemplateId    String? @map("diet_template_id")

  note            String?           @map("note")
  price           Decimal?          @map("price") @db.Decimal(18, 2)
  originalPrice   Decimal?          @map("original_price") @db.Decimal(18, 2)
  status          PlanRequestStatus @default(PENDING) @map("status")
  rejectionReason String?           @map("rejection_reason")
  respondedAt     DateTime?         @map("responded_at")

  createdAt DateTime @default(now()) @map("created_at")

  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  coach           Coach         @relation(fields: [coachId], references: [id], onDelete: Cascade)
  workoutTemplate WorkoutPlan?  @relation("RequestedWorkoutTemplate", fields: [workoutTemplateId], references: [id], onDelete: SetNull)
  dietTemplate    DietPlan?     @relation("RequestedDietTemplate", fields: [dietTemplateId], references: [id], onDelete: SetNull)
  payments        Payment[]
  coachReviews    CoachReview[]
  userPlans       UserPlan[]

  @@index([coachId, status])
  @@index([userId, status])
  @@map("plan_requests")
}

// لاگ به صورت روزانه توانایی اضافه کردن وزن به صورت روزانه
model UserLog {
  id         String   @id @default(uuid())
  userId     String   @map("user_id") @db.Uuid
  userPlanId String?  @map("user_plan_id") // اختیاری: بین دو برنامه هم کاربر می‌تونه وزن ثبت کنه
  date       DateTime @db.Date // روز به وقت Asia/Tehran، نه UTC
  weightKg   Decimal? @map("weight_kg") @db.Decimal(5, 2)

  // ورزش
  plannedExerciseIds String[] @default([]) @map("planned_exercise_ids") // سرور موقع ساخت ردیف پر می‌کنه
  doneExerciseIds    String[] @default([]) @map("done_exercise_ids")
  plannedExercises   Int      @default(0) @map("planned_exercises") // = طول آرایه (برای جمع‌زدن)
  doneExercises      Int      @default(0) @map("done_exercises")
  extraExercises     Json     @default("[]") @map("extra_exercises") // [{name, durationMin, caloriesBurned, note}]
  caloriesBurned     Int?     @map("calories_burned") // تخمینی، اختیاری

  // تغذیه
  plannedMealIds   String[] @default([]) @map("planned_meal_ids")
  doneMealIds      String[] @default([]) @map("done_meal_ids")
  plannedMeals     Int      @default(0) @map("planned_meals")
  doneMeals        Int      @default(0) @map("done_meals")
  extraMeals       Json     @default("[]") @map("extra_meals") // [{name, calories, proteinG, carbsG, fatG}]
  caloriesPlanned  Int?     @map("calories_planned")
  caloriesConsumed Int?     @map("calories_consumed") // وعده‌های انجام‌شده + اضافی‌ها
  proteinG         Int?     @map("protein_g")
  carbsG           Int?     @map("carbs_g")
  fatG             Int?     @map("fat_g")

  userNote  String? @map("user_note")
  coachNote String? @map("coach_note")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userPlan UserPlan? @relation(fields: [userPlanId], references: [id], onDelete: SetNull)

  @@unique([userId, date])
  @@index([userPlanId])
  @@map("user_logs")
}

model UserPlan {
  id     String     @id @default(uuid())
  userId String     @map("user_id") @db.Uuid
  title  String     @map("title")
  status PlanStatus @default(DRAFT) @map("status")
  source PlanSource @default(COACH) @map("source")
  type   PlanType   @default(WORKOUT) @map("type") //WORKOUT | DIET |ALL

  workoutPlanId String? @map("workout_plan_id") // قالب اصلی (فقط برای آمار)
  requestId     String? @map("request_id")
  dietPlanId    String? @map("diet_plan_id")
  coachId       String? @map("coach_id")

  snapshotVersion  Int?  @map("snapshot_version")
  snapshotExercise Json? @map("snapshot_exercise") // زمانی که مربی بخواد به صورت دستی تغییری بده
  snapshotDiet     Json? @map("snapshot_diet") // زمانی که مربی بخواد به صورت دستی تغییری بده

  startDate   DateTime? @map("start_date") @db.Date
  endDate     DateTime? @map("end_date") @db.Date
  activatedAt DateTime? @map("activated_at")

  customizedAt DateTime @map("customized_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  workoutPlan WorkoutPlan? @relation(fields: [workoutPlanId], references: [id], onDelete: Restrict)
  dietPlan    DietPlan?    @relation(fields: [dietPlanId], references: [id], onDelete: Restrict)
  request     PlanRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)
  coach       Coach?       @relation(fields: [coachId], references: [id], onDelete: SetNull)
  userLogs    UserLog[]

  @@index([userId, status])
  @@index([requestId])
  @@map("user_plans")
}

// ورزش و برنامه ها
model WorkoutPlan {
  id                  String            @id @default(uuid())
  title               String            @map("title")
  description         String?           @map("description")
  price               Decimal           @default(0) @map("price") @db.Decimal(18, 2)
  discountPrice       Decimal?          @map("discount_price") @db.Decimal(18, 2)
  dietPlanId          String?           @map("diet_plan_id")
  // سرچ بر اساس پروفایل
  trainingGoalId      String?           @map("training_goal_id")
  activityLevel       ActivityLevel?    @map("activity_level")
  experienceLevel     ExperienceLevel?  @map("level")
  gender              Gender?           @map("gender")
  trainingLocation    TrainingLocation? @map("training_location")
  trainingDaysPerWeek Int?              @map("days_per_week")
  requiredEquipment   String[]          @map("required_equipment")
  isPublished         Boolean           @default(false) @map("is_published") // قالب‌های منتشرشده رو کاربر می‌تونه ببینه و انتخاب کنه
  minAge              Int?              @map("min_age")
  maxAge              Int?              @map("max_age")
  note                String?           @map("note")

  durationWeeks Int?       @map("duration_weeks")
  source        PlanSource @default(COACH) @map("source")

  coachId String? @map("coach_id") // مربی سازنده یا مسئول

  discountExpired DateTime? @map("discount_expired")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  trainingGoal TrainingGoal? @relation(fields: [trainingGoalId], references: [id])
  coach        Coach?        @relation(fields: [coachId], references: [id], onDelete: SetNull)
  dietPlan     DietPlan?     @relation(fields: [dietPlanId], references: [id])
  requestedIn  PlanRequest[] @relation("RequestedWorkoutTemplate")
  days         WorkoutDay[]
  userPlans    UserPlan[]

  @@index([coachId])
  @@index([isPublished])
  @@map("workout_plans")
}

model WorkoutDay {
  id        String  @id @default(uuid())
  planId    String  @map("plan_id")
  dayIndex  Int     @map("day_index") // روز ۱، ۲، ۳ ... داخل برنامه
  title     String? @map("title")
  isRestDay Boolean @default(false) @map("is_rest_day")
  notes     String? @map("notes")

  plan      WorkoutPlan          @relation(fields: [planId], references: [id], onDelete: Cascade)
  exercises WorkoutDayExercise[]

  @@unique([planId, dayIndex])
  @@map("workout_days")
}

model WorkoutDayExercise {
  id          String  @id @default(uuid())
  dayId       String  @map("day_id")
  exerciseId  String  @map("exercise_id")
  order       Int     @map("order")
  sets        Int?    @map("sets")
  reps        String? @map("reps") // "10" یا "8-12" یا "تا ناتوانی"
  durationSec Int?    @map("duration_sec")
  restSec     Int?    @map("rest_sec")
  notes       String? @map("notes")

  day      WorkoutDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  exercise Exercise   @relation(fields: [exerciseId], references: [id], onDelete: Restrict)

  @@index([dayId, order])
  @@map("workout_day_exercises")
}

// برنامه غذایی
model DietPlan {
  id            String   @id @default(uuid())
  title         String   @map("title")
  description   String?  @map("description")
  price         Decimal  @default(0) @map("price") @db.Decimal(18, 2)
  discountPrice Decimal? @map("discount_price") @db.Decimal(18, 2)

  // سرچ بر اساس پروفایل
  trainingGoalId String? @map("training_goal_id")
  targetCalories Int?    @map("target_calories")
  targetProteinG Int?    @map("target_protein_g")
  targetCarbsG   Int?    @map("target_carbs_g")
  targetFatG     Int?    @map("target_fat_g")
  durationWeeks  Int?    @map("duration_weeks")

  isPublished Boolean    @default(false) @map("is_published")
  source      PlanSource @default(COACH) @map("source")

  coachId String? @map("coach_id")

  discountExpired DateTime? @map("discount_expired")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  coach        Coach?        @relation(fields: [coachId], references: [id], onDelete: SetNull)
  requestedIn  PlanRequest[] @relation("RequestedDietTemplate")
  days         DietDay[]
  workoutPlans WorkoutPlan[]
  userPlans    UserPlan[]
  trainingGoal TrainingGoal? @relation(fields: [trainingGoalId], references: [id])

  @@index([coachId])
  @@index([isPublished])
  @@map("diet_plans")
}

model DietDay {
  id       String  @id @default(uuid())
  planId   String  @map("plan_id")
  dayIndex Int     @map("day_index")
  title    String? @map("title")
  notes    String? @map("notes")

  plan  DietPlan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  meals DietMeal[]

  @@unique([planId, dayIndex])
  @@map("diet_days")
}

model DietMeal {
  id       String       @id @default(uuid())
  dayId    String       @map("day_id")
  type     MealType     @map("type")
  priority Prioritytype @default(PRIMARY) @map("priority")
  order    Int          @map("order")
  notes    String?      @map("notes")

  day   DietDay        @relation(fields: [dayId], references: [id], onDelete: Cascade)
  items DietMealItem[]

  @@index([dayId, order])
  @@map("diet_meals")
}

model DietMealItem {
  id            String  @id @default(uuid())
  mealId        String  @map("meal_id")
  foodId        String  @map("food_id")
  quantityGrams Float   @map("quantity_grams")
  notes         String? @map("notes")

  meal DietMeal @relation(fields: [mealId], references: [id], onDelete: Cascade)
  food Food     @relation(fields: [foodId], references: [id], onDelete: Restrict)

  @@index([mealId])
  @@map("diet_meal_items")
}

// فروشنده
model Store {
  id               String        @id @default(uuid())
  userId           String        @unique @map("owner_id") @db.Uuid // اگه بعداً خواستی multi-store بشه، unique رو بردار
  name             String        @map("name")
  slug             String        @unique @map("slug")
  logo             String?       @map("logo")
  banner           String?       @map("banner")
  description      String?       @map("description")
  businessType     BusinessType  @default(INDIVIDUAL) @map("business_type") // حقیقی / حقوقی
  nationalId       String?       @map("national_id") // کد ملی یا شناسه ملی
  economicCode     String?       @map("economic_code")
  commissionRate   Decimal       @default(0) @map("commission_rate") @db.Decimal(12, 2)
  status           DefaultStatus @default(PENDING) @map("status")
  statusReason     String?       @map("status_reason")
  isActive         Boolean       @default(false) @map("is_active")
  isVerified       Boolean       @default(false) @map("is_verified")
  address          String?       @map("address")
  phone            String?       @map("phone")
  email            String?       @map("email")
  instagram        String?       @map("instagram")
  telegram         String?       @map("telegram")
  whatsApp         String?       @map("whats_app")
  bale             String?       @map("bale")
  robika           String?       @map("robika")
  shippingTime     String?       @map("shipping_time")
  taxRate          Decimal       @default(9) @map("tax_rate") @db.Decimal(5, 2)
  workingHours     String?       @map("working_hours")
  hasPhysicalStore Boolean       @default(false) @map("has_physical_store")

  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  provinceId String?  @map("province_id")
  cityId     String?  @map("city_id")

  province             Province?             @relation(fields: [provinceId], references: [id])
  city                 City?                 @relation(fields: [cityId], references: [id])
  owner                User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  products             Product[]
  rating               StoreRating?
  storeReview          StoreReview[]
  orders               Order[]
  orderItems           OrderItem[]
  discountCodeStores   DiscountCodeStore[]
  storeShippingMethods StoreShippingMethod[]

  @@index([isActive, isVerified])
  @@index([isActive, isVerified, name])
  @@map("stores")
}

model StoreRating {
  id           String @id @default(uuid())
  avgRating    Float  @default(0) @map("avg_rating")
  ratingTotal  Float  @default(0) @map("rating_total")
  totalReviews Int    @default(0) @map("total_reviews")

  productCount        Int   @default(0) @map("product_count")
  productQuality      Float @default(5) @map("product_quality")
  productQualityTotal Float @default(0) @map("product_quality_total")
  productQualityCount Int   @default(0) @map("product_quality_count")

  totalResponseRequests Int   @default(0) @map("total_response_requests")
  answeredResponses     Int   @default(0) @map("answered_responses")
  totalResponseTime     Float @default(0) @map("total_response_time")
  responseRate          Float @default(100) @map("response_rate")
  responseTime          Float @default(0) @map("response_time")

  saleCount   Int      @default(0) @map("sale_count")
  returnCount Int      @default(0) @map("return_count")
  updatedAt   DateTime @updatedAt @map("updated_at")

  storeId String @unique @map("seller_id")
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([avgRating])
  @@index([totalReviews])
  @@index([productQuality])
  @@index([answeredResponses])
  @@index([responseRate])
  @@index([responseTime])
  @@index([saleCount])
  @@map("store_ratings")
}

// محصولات
model Product {
  id              String        @id @default(uuid())
  title           String        @map("title")
  slug            String        @unique @map("slug")
  metaTitle       String?       @map("meta_title")
  content         Json?         @map("content")
  description     String        @map("description")
  originalPrice   Decimal?      @map("original_price") @db.Decimal(12, 2)
  minPrice        Decimal?      @map("min_Price") @db.Decimal(12, 2)
  discountPercent String?       @map("discount_percent")
  status          StatusProduct @default(DRAFT)
  isFeatured      Boolean       @default(false) @map("is_featured")
  viewCount       Int           @default(0) @map("view_count")
  saleCount       Int           @default(0) @map("sale_count")
  rating          Float         @default(0)
  reviewCount     Int           @default(0) @map("review_count")
  productTable    Json?         @map("product_table")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  countryId       String?       @map("country_id")
  categoryId      String        @map("category_id")
  brandId         String?       @map("brand_id")
  storeId         String        @map("store_id")

  store         Store            @relation(fields: [storeId], references: [id])
  brand         Brand?           @relation(fields: [brandId], references: [id])
  country       Countries?       @relation(fields: [countryId], references: [id])
  category      Category         @relation(fields: [categoryId], references: [id])
  cartItems     CartItem[]
  orderItems    OrderItem[]
  images        Media[]
  variants      ProductVariant[]
  reviews       Review[]
  wishlistItems WishlistItem[]

  @@index([storeId])
  @@index([categoryId])
  @@index([status])
  @@index([isFeatured])
  @@index([minPrice])
  @@index([saleCount])
  @@index([rating])
  @@index([updatedAt])
  @@map("products")
}

model ProductVariant {
  id         String   @id @default(uuid())
  name       String   @map("name")
  sku        String?  @unique @map("sku")
  price      Decimal? @map("price") @db.Decimal(12, 2)
  quantity   Int      @default(0) @map("quantity")
  colorId    String?  @map("color_id")
  image      String?  @map("image")
  saleCount  Int      @default(0) @map("sale_count")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  discountId String?  @map("discount_id")
  productId  String   @map("product_id")

  cartItems  CartItem[]
  orderItems OrderItem[]
  attributes VariantAttributeValue[]
  discount   DiscountCode?           @relation(fields: [discountId], references: [id], onDelete: SetNull)
  color      Color?                  @relation(fields: [colorId], references: [id], onDelete: SetNull)
  product    Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_variants")
}

model AttributeDefinition {
  id       String                  @id @default(uuid())
  key      String                  @unique @map("key")
  label    String                  @map("label")
  category Category[]
  values   VariantAttributeValue[]

  @@map("attribute_definition")
}

model VariantAttributeValue {
  id          String              @id @default(uuid())
  value       String              @map("value")
  variantId   String              @map("variant_id")
  variant     ProductVariant      @relation(fields: [variantId], references: [id], onDelete: Cascade)
  attributeId String              @map("attribute_id")
  attribute   AttributeDefinition @relation(fields: [attributeId], references: [id])

  @@unique([variantId, attributeId])
  @@index([attributeId, value])
  @@map("variant_attribute_value")
}

// نظرات
model Review {
  id               String   @id @default(uuid())
  rating           Int
  title            String?
  body             String
  answerReview     String?  @map("answer_review")
  answerId         String?  @map("answer_id") @db.Uuid
  isApproved       Boolean  @default(false) @map("is_approved")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  verifiedPurchase Boolean  @default(false)
  variantInfo      Json?    @map("variant_info")
  userId           String   @map("user_id") @db.Uuid
  productId        String   @map("product_id")
  orderId          String?  @map("order_id")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation("ReviewUser", fields: [userId], references: [id])
  answer  User?   @relation("ReviewAnswer", fields: [answerId], references: [id])

  @@unique([userId, productId])
  @@index([productId])
  @@index([userId])
  @@index([isApproved])
  @@index([answerId])
  @@map("reviews")
}

model StoreReview {
  id               String        @id @default(uuid())
  userId           String        @map("user_id") @db.Uuid
  verifiedPurchase Boolean       @default(false)
  rating           Int           @map("rating")
  body             String?       @map("body")
  productQuality   Int?          @map("product_quality")
  productName      String?       @map("product_name")
  status           DefaultStatus @default(PENDING) @map("status")
  answerReview     String?       @map("answer_review")
  answerAt         DateTime?     @map("answer_at")
  responseAt       DateTime?     @map("response_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  storeId String @map("store_id")

  user  User  @relation(fields: [userId], references: [id])
  store Store @relation(fields: [storeId], references: [id])

  @@unique([userId, storeId])
  @@index([storeId])
  @@index([userId])
  @@index([status])
  @@map("store_reviews")
}

model CoachReview {
  id            String        @id @default(uuid())
  planRequestId String
  status        DefaultStatus @default(PENDING) @map("status")
  coachId       String
  authorId      String        @db.Uuid
  comment       String?
  rating        Int           @map("rating")
  answerReview  String?       @map("answer_review")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  createdAt     DateTime      @default(now())
  coach         Coach         @relation(fields: [coachId], references: [id], onDelete: Cascade)
  author        User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  planRequest   PlanRequest   @relation(fields: [planRequestId], references: [id])

  @@unique([coachId, authorId])
  @@index([coachId])
  @@map("coach_reviews")
}

// مدل های مربوطه به سفارش
model Order {
  id               String      @id @default(uuid())
  orderNumber      String      @unique @map("order_number")
  status           OrderStatus @default(PENDING) @map("status")
  shippingCost     Decimal     @default(0) @map("shipping_cost") @db.Decimal(12, 2)
  shippingName     String?     @map("shipping_name")
  storeName        String      @map("store_name")
  commission       Decimal     @map("commission") @db.Decimal(12, 2)
  commissionAmount Decimal     @default(0) @map("commission_amount") @db.Decimal(12, 2)
  subtotal         Decimal     @map("subtotal") @db.Decimal(13, 2)
  totalPrice       Decimal     @map("total_price") @db.Decimal(13, 2)
  discountAmount   Decimal     @default(0) @map("discount_amount") @db.Decimal(12, 2)
  note             String?     @map("note")
  trackingCode     String?     @map("tracking_code")
  taxAmount        Decimal     @default(0) @map("tax_amount") @db.Decimal(12, 2)

  checkoutId            String    @map("checkout_id")
  storeId               String    @map("store_id")
  userId                String    @map("user_id") @db.Uuid
  storeShippingMethodId String?   @map("shipping_method_id")
  discountCodeId        String?   @map("discount_code_id")
  deliveredAt           DateTime? @map("delivered_at")
  cancelledAt           DateTime? @map("cancelled_at")
  returnDeadline        DateTime? @map("return_deadline")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  checkout            Checkout             @relation(fields: [checkoutId], references: [id])
  store               Store                @relation(fields: [storeId], references: [id])
  user                User                 @relation(fields: [userId], references: [id]) // نگه دار برای کوئری سریع‌تر
  items               OrderItem[]
  returnRequests      ReturnRequest[]
  ticket              Ticket?
  storeShippingMethod StoreShippingMethod? @relation(fields: [storeShippingMethodId], references: [id])
  discountCode        DiscountCode?        @relation(fields: [discountCodeId], references: [id])
  walletTransactions  WalletTransaction[]

  @@index([userId])
  @@index([storeId])
  @@index([status])
  @@index([checkoutId])
  @@map("orders")
}

model CartItem {
  id       String @id @default(uuid())
  quantity Int    @default(1)

  userId    String         @map("user_id") @db.Uuid
  productId String         @map("product_id")
  variantId String         @map("variant_id")
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  product   Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([userId, variantId])
  @@index([userId])
  @@map("cart_items")
}

model OrderItem {
  id            String   @id @default(uuid())
  sku           String   @map("sku")
  name          String   @map("name")
  price         Decimal  @map("price") @db.Decimal(12, 2)
  originalPrice Decimal? @map("original_price") @db.Decimal(12, 2)
  total         Decimal  @map("total") @db.Decimal(13, 2)
  quantity      Int      @map("quantity")
  returnedQty   Int?     @default(0) @map("returned_qty")
  attributes    Json?    @map("attributes")
  colorName     String?  @map("color_name")
  colorHex      String?  @map("color_hex")

  orderId     String         @map("order_id")
  productId   String         @map("product_id")
  storeId     String         @map("store_id")
  variantId   String         @map("variant_id")
  createdAt   DateTime       @default(now()) @map("created_at")
  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product        @relation(fields: [productId], references: [id])
  store       Store          @relation(fields: [storeId], references: [id])
  variant     ProductVariant @relation(fields: [variantId], references: [id])
  returnItems ReturnItem[]

  @@index([orderId])
  @@index([storeId])
  @@map("order_items")
}

model Checkout {
  id               String          @id @default(uuid())
  checkoutNumber   String          @unique @map("checkout_number")
  commissionAmount Decimal         @default(0) @map("commission_amount") @db.Decimal(13, 2)
  salesProfit      Decimal         @default(0) @map("sales_profit") @db.Decimal(13, 2)
  totalAmount      Decimal         @map("total_amount") @db.Decimal(13, 2)
  discountAmount   Decimal         @default(0) @map("discount_amount") @db.Decimal(13, 2)
  taxAmount        Decimal         @default(0) @map("tax_amount") @db.Decimal(13, 2)
  discountStatus   StatusDiscount? @map("discount_status")
  status           OrderStatus     @default(PENDING) @map("status")
  paymentStatus    PaymentStatus   @default(PENDING) @map("payment_status")
  paymentMethod    PaymentMethod?  @map("payment_method")
  paymentRef       String?         @map("payment_ref")
  shippingName     String          @map("shipping_name")
  shippingPhone    String          @map("shipping_phone")
  shippingCity     String          @map("shipping_city")
  shippingProvince String          @map("shipping_province")
  shippingAddress  String          @map("shipping_address")
  shippingPostal   String          @map("shipping_postal")

  discountId String?       @map("discount_id")
  userId     String        @map("user_id") @db.Uuid
  addressId  String?       @map("address_id")
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")
  user       User          @relation(fields: [userId], references: [id])
  address    Address?      @relation(fields: [addressId], references: [id])
  discount   DiscountCode? @relation(fields: [discountId], references: [id])
  orders     Order[]
  payments   Payment[]

  @@index([userId])
  @@map("checkouts")
}

model Payment {
  id             String        @id @default(uuid())
  amount         Decimal       @map("amount") @db.Decimal(18, 2)
  method         PaymentMethod @map("method")
  status         PaymentStatus @default(PENDING)
  gatewayRef     String?       @map("gateway_ref")
  authority      String?       @map("authority")
  errorMessage   String?       @map("error_message")
  checkoutId     String?       @map("checkout_id")
  planRequestId  String?       @map("plan_request_id")
  subscriptionId String?       @map("subscription_id")
  paidAt         DateTime?     @map("paid_at")
  createdAt      DateTime      @default(now()) @map("created_at")

  checkout     Checkout?     @relation(fields: [checkoutId], references: [id], onDelete: Restrict)
  planRequest  PlanRequest?  @relation(fields: [planRequestId], references: [id], onDelete: Restrict)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)

  @@index([planRequestId])
  @@index([subscriptionId])
  @@index([checkoutId])
  @@map("payments")
}

model ReturnRequest {
  id                 String        @id @default(uuid())
  requestNumber      String        @unique @map("request_number")
  orderId            String        @map("order_id")
  userId             String        @map("user_id") @db.Uuid
  status             ReturnStatus  @default(REQUESTED)
  reason             String        @map("reason")
  reasonDetail       String?       @map("reason_detail")
  refundMethod       RefundMethod? @map("refund_method")
  refundAmount       Decimal?      @map("refund_amount") @db.Decimal(12, 2)
  returnShippingCost Decimal?      @map("return_shipping_cost") @db.Decimal(12, 2)
  adminNote          String?       @map("admin_note")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")
  resolvedAt         DateTime?     @map("resolved_at")

  order              Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user               User                @relation(fields: [userId], references: [id])
  items              ReturnItem[]
  images             Media[]
  walletTransactions WalletTransaction[]

  @@index([orderId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("return_requests")
}

model ReturnItem {
  id              String   @id @default(uuid())
  returnRequestId String   @map("return_request_id")
  orderItemId     String   @map("order_item_id")
  quantity        Int
  reason          String?
  condition       String? // سالم / آسیب‌دیده / بازکرده و... برای بررسی انبار فروشنده
  unitRefund      Decimal? @map("unit_refund") @db.Decimal(12, 2)
  createdAt       DateTime @default(now()) @map("created_at")

  returnRequest ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  orderItem     OrderItem     @relation(fields: [orderItemId], references: [id])

  @@index([returnRequestId])
  @@index([orderItemId])
  @@map("return_items")
}

// عکس و برند و دسته و علاقه مندی و رنگ

model Media {
  id              String       @id @default(uuid())
  productId       String?      @map("product_id")
  reportsId       String?
  ticketMessageId String?
  returnRequestId String?
  size            Int?         @default(0)
  url             String       @unique
  alt             String?
  useCase         MediaUseCase @default(PRODUCT) @map("use_case")
  sortOrder       Int          @default(0) @map("sort_order")
  type            TypeMedia    @default(OTHER)
  isMain          Boolean      @default(false) @map("is_main")

  createdAt DateTime @default(now()) @map("created_at")

  product       Product?       @relation(fields: [productId], references: [id], onDelete: Cascade)
  reports       Reports?       @relation(fields: [reportsId], references: [id])
  ticketMessage TicketMessage? @relation(fields: [ticketMessageId], references: [id])
  returnRequest ReturnRequest? @relation(fields: [returnRequestId], references: [id])

  @@index([productId])
  @@map("media")
}

model Brand {
  id          String    @id @default(uuid())
  name        String
  sortOrder   Int?      @default(0)
  slug        String    @unique
  logo        String?
  description String?
  products    Product[]

  @@map("brands")
}

model Countries {
  id       String    @id @default(uuid())
  name     String
  slug     String    @unique
  flag     String?
  products Product[]

  @@map("countries")
}

model Category {
  id              String   @id @default(uuid())
  name            String
  slug            String   @unique
  parentId        String?  @map("parent_id")
  icon            String?
  image           String?
  ancestorIds     String[] @default([])
  sortOrder       Int      @default(0) @map("sort_order")
  isActive        Boolean  @default(true) @map("is_active")
  metaTitle       String?  @map("meta_title")
  metaDescription String?  @map("meta_description")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  parent               Category?             @relation("CategoryTree", fields: [parentId], references: [id])
  children             Category[]            @relation("CategoryTree")
  products             Product[]
  attributeDefinitions AttributeDefinition[]
  exercises            Exercise[]
  food                 Food[]

  @@index([parentId])
  @@index([isActive, sortOrder])
  @@map("categories")
}

model Color {
  id              String           @id @default(uuid())
  name            String           @map("name")
  hexCode         String           @map("hex_code")
  slug            String           @unique @map("slug")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  productVariants ProductVariant[]

  @@map("color")
}

model WishlistItem {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")
  userId    String   @map("user_id") @db.Uuid
  productId String   @map("product_id")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("wishlist_items")
}

// کیف پول و تراکنش و بانک
model Wallet {
  id              String  @id @default(uuid())
  userId          String  @unique @map("user_id") @db.Uuid
  balance         Decimal @default(0) @db.Decimal(18, 2)
  pendingBalance  Decimal @default(0) @map("pending_balance") @db.Decimal(18, 2)
  withdrawBalance Decimal @default(0) @map("withdraw_balance") @db.Decimal(18, 2)
  frozenBalance   Decimal @default(0) @map("frozen_balance") @db.Decimal(18, 2)
  isPlatform      Boolean @default(false) @map("is_platform")

  bankAccountId String?             @map("bank_account_id")
  updatedAt     DateTime            @updatedAt @map("updated_at")
  createdAt     DateTime            @default(now()) @map("created_at")
  user          User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  transactions  WalletTransaction[]
  bankAccounts  BankAccount[]

  @@map("wallets")
}

model WalletTransaction {
  id           String                  @id @default(uuid())
  type         WalletTransactionType   @map("type")
  status       WalletTransactionStatus @default(COMPLETED)
  amount       Decimal                 @map("amount") @db.Decimal(18, 2)
  trackingCode String                  @unique @map("tracking_code")
  description  String?                 @map("description")

  userId          String    @map("user_id") @db.Uuid
  walletId        String    @map("wallet_id")
  orderId         String?   @map("order_id")
  returnRequestId String?   @map("return_request_id")
  settlementDate  DateTime? @map("settlement_date")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  wallet        Wallet         @relation(fields: [walletId], references: [id], onDelete: Restrict)
  user          User           @relation(fields: [userId], references: [id])
  order         Order?         @relation(fields: [orderId], references: [id])
  returnRequest ReturnRequest? @relation(fields: [returnRequestId], references: [id])

  @@index([userId])
  @@index([walletId])
  @@index([type, status])
  @@index([orderId])
  @@index([userId, createdAt])
  @@map("wallet_transactions")
}

model BankAccount {
  id            String  @id @default(uuid())
  bankName      String? @map("bank_name")
  accountHolder String  @map("account_holder")
  iban          String  @map("iban")
  cardNumber    String? @map("card_number")
  isDefault     Boolean @default(false) @map("is_default")
  isVerified    Boolean @default(false) @map("is_verified")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  userId    String   @map("user_id") @db.Uuid
  walletId  String?  @map("wallet_id")

  user   User    @relation(fields: [userId], references: [id], onDelete: Restrict)
  wallet Wallet? @relation(fields: [walletId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("bank_accounts")
}

// تخفیف
model DiscountCode {
  id             String         @id @default(uuid())
  code           String         @unique @map("code")
  description    String?
  maxDiscount    Decimal?       @map("max_discount") @db.Decimal(12, 2)
  value          Decimal        @map("value") @db.Decimal(12, 2)
  minOrderAmount Decimal        @default(0) @map("min_order_amount") @db.Decimal(12, 2)
  usageLimit     Int            @default(0) @map("usage_limit")
  usedCount      Int            @default(0) @map("used_count")
  perUserLimit   Int            @default(0) @map("per_user_limit")
  isActive       Boolean        @default(true) @map("is_active")
  status         StatusDiscount @default(PRODUCT)
  type           DiscountType   @default(PERCENTAGE) @map("type")

  userId    String?  @map("user_id") @db.Uuid
  startsAt  DateTime @map("starts_at")
  endsAt    DateTime @map("ends_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  usages             DiscountCodeUsage[]
  user               User?               @relation("DiscountCodeCreator", fields: [userId], references: [id])
  orders             Order[]
  productVariants    ProductVariant[]
  checkouts          Checkout[]
  discountCodeStores DiscountCodeStore[]

  @@index([userId])
  @@map("discount_codes")
}

model DiscountCodeStore {
  discountCodeId String
  storeId        String

  discountCode DiscountCode @relation(fields: [discountCodeId], references: [id], onDelete: Cascade)
  store        Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@id([discountCodeId, storeId])
  @@index([storeId])
  @@map("discount_code_stores")
}

model DiscountCodeUsage {
  id             String       @id @default(uuid())
  createdAt      DateTime     @default(now()) @map("created_at")
  discountCodeId String       @map("discount_code_id")
  userId         String       @map("user_id") @db.Uuid
  discountCode   DiscountCode @relation(fields: [discountCodeId], references: [id], onDelete: Cascade)
  amount         Decimal      @db.Decimal(12, 2)

  @@index([discountCodeId])
  @@index([userId])
  @@map("discount_code_usages")
}

// شهر و استان
model Province {
  id                 String              @id @default(uuid())
  name               String              @unique @map("name")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  cities             City[]
  store              Store[]
  storeShippingRates StoreShippingRate[]
  addresses          Address[]
  coaches            Coach[]

  @@map("provinces")
}

model City {
  id         String    @id @default(uuid())
  name       String    @map("name")
  provinceId String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  province   Province  @relation(fields: [provinceId], references: [id])
  store      Store[]
  addresses  Address[]
  coaches    Coach[]

  @@unique([provinceId, name])
  @@index([provinceId])
  @@map("cities")
}

// پشتیبانی و گزارش ها
model Ticket {
  id             String          @id @default(uuid())
  status         TicketStatus    @default(PENDING)
  priority       TicketPriority
  title          String
  trackingCode   String
  isUserRead     Boolean         @default(false)
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  userId         String          @map("user_id") @db.Uuid
  orderId        String?         @unique @map("order_id") // ✅ unique می‌ماند
  ticketMessages TicketMessage[]
  order          Order?          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([priority])
  @@map("tickets")
}

model TicketMessage {
  id        String   @id @default(cuid())
  content   String
  ticketId  String
  senderId  String   @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  images    Media[]
  sender    User     @relation(fields: [senderId], references: [id])
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([senderId])
  @@index([createdAt])
  @@map("ticket_messages")
}

model Reports {
  id           String        @id @default(uuid())
  nameSeller   String?
  content      String
  title        String
  orderCode    String?
  trackingCode String?
  status       ReportsStatus @default(PENDING)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  images       Media[]

  @@index([status])
  @@map("reports")
}

// ارسال
model ShippingMethod {
  id           String  @id @default(uuid())
  name         String  @unique @map("name")
  isFreeMethod Boolean @default(false) @map("is_free_method")
  isActive     Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  storeShippingMethods StoreShippingMethod[]

  @@index([isActive])
  @@map("shipping_methods")
}

model StoreShippingMethod {
  id           String   @id @default(uuid())
  isActive     Boolean  @default(true) @map("is_active")
  description  String?  @map("description")
  phrase       String?  @map("phrase")
  minDays      Int      @map("min_days")
  maxDays      Int      @map("max_days")
  defaultPrice Decimal? @map("default_price") @db.Decimal(12, 2)

  storeId          String
  shippingMethodId String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  store          Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  shippingMethod ShippingMethod      @relation(fields: [shippingMethodId], references: [id], onDelete: Cascade)
  rates          StoreShippingRate[]
  orders         Order[]

  @@unique([storeId, shippingMethodId])
  @@index([storeId])
  @@index([shippingMethodId])
  @@map("store_shipping_methods")
}

model StoreShippingRate {
  id              String  @id @default(uuid())
  price           Decimal @map("price") @db.Decimal(12, 2)
  deliveryMaxDays Int     @map("delivery_max_days")

  storeShippingMethodId String
  provinceId            String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  storeShippingMethod StoreShippingMethod @relation(fields: [storeShippingMethodId], references: [id], onDelete: Cascade)
  province            Province            @relation(fields: [provinceId], references: [id], onDelete: Cascade)

  @@unique([storeShippingMethodId, provinceId])
  @@index([provinceId])
  @@map("store_shipping_rates")
}

enum StatusProduct {
  DRAFT // پیش‌نویس (فروشنده در حال ساخت محصول است و هنوز آن را ثبت نکرده)
  PENDING // در انتظار تایید (فروشنده ثبت کرده، منتظر بررسی ادمین است)
  ACTIVE // فعال و منتشر شده (تایید شده و در سایت برای خرید نمایش داده می‌شود)
  REJECTED // رد شده (ادمین به دلایلی مثل نقض قوانین، محصول را رد کرده است)
  INACTIVE // غیرفعال (فروشنده به صورت دستی محصول را از دسترس خارج کرده است)
  OUT_OF_STOCK // ناموجود (تایید شده است، اما موجودی همه وریانت‌ها صفر شده است)
  DELETED // حذف شده (حذف نرم / Soft Delete برای نگه داشتن سوابق سفارشات)
  BANNED // مسدود شده (ادمین به دلیل تخلف شدید، محصول را کلاً مسدود کرده است)
}

