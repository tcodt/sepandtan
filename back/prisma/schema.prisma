  // کسر از کیف‌پول فروشنده بابت مرجوعی کالا
  RETURN_DEDUCTION
}

enum WalletTransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum TicketStatus {
  PENDING
  WAITING
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
  CRITICAL
}

enum MediaUseCase {
  AVATAR
  PRODUCT
  POST
  ATTACHMENT
  THUMBNAIL
  WATERMARK
  REPORTS
  MAINS
}

enum TypeMedia {
  VIDEO
  IMAGE
  VOICE
  FILE
  BANNER
  AVATAR
}

enum ReportsStatus {
  PENDING
  RESOLVED
  CLOSED
}

enum CoachStatus {
  PENDING // درخواست ثبت‌نام داده، منتظر تایید ادمین
  APPROVED
  REJECTED
  SUSPENDED
}

enum CoachClientStatus {
  PENDING // درخواست همکاری ارسال شده
  ACTIVE
  PAUSED
  ENDED
  REJECTED
}

enum PlanStatus {
  DRAFT // مربی در حال ویرایشه، کاربر نمی‌بینه
  ACTIVE // فعال و قفل‌شده (snapshot)
  COMPLETED // تموم شده یا با برنامه جدید جایگزین شده
  CANCELLED
}

enum PlanRequestStatus {
  PENDING
  ACCEPTED
  PAID
  DELIVERED
  REJECTED
  CANCELLED
}

enum PlanSource {
  COACH
  AI
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}
