  },
  "tags": [],
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local Server"
    },
    {
      "url": "https://domaintest.com",
      "description": "Test Server..."
    }
  ],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "PaginatedResponse": {
        "type": "object",
        "properties": {}
      },
      "UserEntity": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "phone": {
            "type": "object"
          },
          "role": {
            "type": "object"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "email",
          "phone",
          "role",
          "createdAt",
          "updatedAt"
        ]
      },
      "UpdateUserDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "ali 123"
          },
          "role": {
            "type": "string",
            "enum": [
              "USER",
              "ADMIN",
              "CONTRACTOR",
              "AUTHOR"
            ],
            "example": "USER"
          },
          "password": {
            "type": "string",
            "example": "123"
          },
          "phone": {
            "type": "string",
            "example": "09390199977"
          },
          "email": {
            "type": "string",
            "example": "r.khani1385@gmail.com"
          },
          "id": {
            "type": "string",
            "example": "e3e9586b-9680-477e-86af-5f10f8c17433",
            "description": "شناسه اختیاری برای آپدیت پروفایل دیگران"
          }
        },
        "required": [
          "id"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "ali"
          },
          "email": {
            "type": "string",
            "example": "ali@example.com"
          },
          "password": {
            "type": "string",
            "example": "123",
            "description": "There is no need for a password when the user logs in with a Google account."
          },
          "phone": {
            "type": "string",
            "example": "09390199977",
            "description": "There is no need for a password when the user logs in with a Google account."
          },
          "googleId": {
            "type": "string",
            "example": "710927351",
            "description": "There is no need for a googleId when the user logs in with a Password."
          },
          "remember": {
            "type": "boolean",
            "example": false,
            "description": "this for remember me."
          }
        },
        "required": [
          "name",
          "email"
        ]
      },
      "AuthEntities": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "googleId": {
            "type": "string",
            "nullable": true,
            "example": "google-uid-123"
          },
          "phone": {
            "type": "string",
            "nullable": true,
            "example": "09390199977"
          },
          "role": {
            "type": "string",
            "example": "USER",
            "enum": [
              "USER",
              "ADMIN",
              "CONTRACTOR",
              "AUTHOR",
              "COACH"
            ]
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "createdAt"
        ]
      }
    }
  }
}